# FlexPulse-ML Environment Configuration (Optional defaults)
# Copy to .env if you wish to override local defaults.

# Lab Hardware Serial Port Configuration (e.g. /dev/tty.usbserial-0001 on macOS)
FLEXPULSE_SERIAL_PORT=/dev/tty.usbserial-0001
FLEXPULSE_SERIAL_BAUD=115200

# Research Provenance Metadata
FLEXPULSE_OPERATOR_NAME=ResearchEngineer_PU
FLEXPULSE_LAB_LOCATION=Presidency_University_ECE_Lab

# Data & Logging Paths
FLEXPULSE_DATA_DIR=data
FLEXPULSE_LOG_LEVEL=INFO
