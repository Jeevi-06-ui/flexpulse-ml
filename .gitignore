# Virtual Environment
.venv/
venv/
env/
ENV/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# IDE & OS Files
.DS_Store
.idea/
.vscode/
*.swp

# ML Models & Serialized Checkpoints (large binary files)
models/*.joblib
models/*.pkl
models/*.onnx

# Raw data protection (prevent accidental check-in of huge or proprietary lab captures)
data/raw/real/*.bin
data/raw/real/*.csv

# Temporary files & Logs
*.log
.env
